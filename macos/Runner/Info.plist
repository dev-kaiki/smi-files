<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- Separado do PRODUCT_NAME de proposito. O PRODUCT_NAME vira o
	     nome do arquivo .app, e um espaco ali quebra o `open` que o
	     `flutter run` dispara para trazer a janela para a frente.
	     O macOS prefere o CFBundleDisplayName para exibir, entao o
	     nome com espaco continua aparecendo no menu e no Dock. -->
	<key>CFBundleDisplayName</key>
	<string>SMI Files</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSCameraUsageDescription</key>
	<string>A camera e usada para registrar fotos e videos da ordem de servico em campo.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>O microfone grava o audio dos videos anexados a ordem de servico.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O acesso as fotos permite anexar imagens ja existentes no aparelho a ordem de servico.</string>
</dict>
</plist>
